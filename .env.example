APP_NAME=async-webhook-engine
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

SECRET_KEY=change-this-super-secret-key-in-production-use-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

POSTGRES_USER=webhook_user
POSTGRES_PASSWORD=webhook_password
POSTGRES_DB=webhook_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://webhook_user:webhook_password@localhost:5432/webhook_db
SYNC_DATABASE_URL=postgresql://webhook_user:webhook_password@localhost:5432/webhook_db

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=3
